<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.dpdns.clevebitr"
    android:versionCode="1"
    android:versionName="v0.1.0-nogit-260926" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="35" />

    <!--
        引擎通过 engine_open_game(path) 消费**裸文件系统路径**，content:// URI
        无法直接解析为真实路径，因此不用 SAF，改用全文件访问权限。
        API 24-28 走 READ_EXTERNAL_STORAGE + requestLegacyExternalStorage；
        API 30+ 引导用户在系统设置里授予 MANAGE_EXTERNAL_STORAGE。
    -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
        刮削（VNDB）与封面下载需要联网。**没有它刮削功能只会报"无法连接"**，
        而这类失败在模拟器/断网时看起来像是代码 bug，所以权限就写在这里说清楚。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ANGLE 已移除，走平台自带的 GLES 驱动 -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

    <permission
        android:name="org.dpdns.clevebitr.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="org.dpdns.clevebitr.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:name="org.dpdns.clevebitr.KrKr2NextApplication"
        android:allowBackup="false"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.KrKr2Next" >
        <activity
            android:name="org.dpdns.clevebitr.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            崩溃界面必须跑在独立进程里：它是在主进程即将被 killProcess 掉的时刻被拉起来
            的，同进程的话它一出生就会被一起杀掉。代价是拿不到内存状态，因此它只读崩溃
            报告文件。taskAffinity="" + excludeFromRecents 让它不进最近任务、也不搅乱
            主进程的任务栈。
        -->
        <activity
            android:name="org.dpdns.clevebitr.CrashActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|navigation|uiMode|density|smallestScreenSize"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleInstance"
            android:process=":crash"
            android:resizeableActivity="false"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity=""
            android:theme="@style/Theme.KrKr2Next" />

        <!--
            供「分享日志」把 logs/ 下的文件以 content:// 交给别的应用。
            只读授权、exported=false，白名单见 res/xml/file_paths.xml。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="org.dpdns.clevebitr.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="androidx.compose.ui.tooling.PreviewActivity"
            android:exported="true" />

        <uses-library
            android:name="androidx.window.extensions"
            android:required="false" />
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="org.dpdns.clevebitr.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>